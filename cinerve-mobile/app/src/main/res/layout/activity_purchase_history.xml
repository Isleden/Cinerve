<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#000000">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="18sp"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purchase History"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all your bookings"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F2937"/>

        <!-- Filter Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All Bookings"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#DC2626"
                android:layout_marginEnd="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <Button
                android:id="@+id/btnUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Upcoming"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#1F2937"
                android:layout_marginEnd="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <Button
                android:id="@+id/btnCompleted"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Completed"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#1F2937"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

        </LinearLayout>

        <!-- Content -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:indeterminateTint="#DC2626"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No bookings yet."
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="32dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/llBookings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"/>

        </ScrollView>
    </LinearLayout>

    <!-- Ticket Modal Overlay -->
    <LinearLayout
        android:id="@+id/llTicketModal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:padding="24dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cinema_card_background"
                android:padding="24dp">

                <!-- Cinerve Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="C"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="#DC2626"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cinerve"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cinema Reservation Ticket"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Status -->
                <TextView
                    android:id="@+id/tvTicketStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/genre_badge_background"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Booking Reference -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_background"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booking Reference"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvBookingRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present to cashier to claim tickets"
                        android:textColor="#6B7280"
                        android:textSize="11sp"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Ticket Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/input_background"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Movie" android:textColor="#6B7280" android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tvTicketMovie" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cinema" android:textColor="#6B7280" android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tvTicketCinema" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Showtime" android:textColor="#6B7280" android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tvTicketShowtime" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Seats" android:textColor="#6B7280" android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tvTicketSeats" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Payment Method" android:textColor="#6B7280" android:textSize="11sp"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tvTicketPayment" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Close Button -->
                <Button
                    android:id="@+id/btnCloseTicket"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Close"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#DC2626"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>